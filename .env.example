# Copy to `.env` (repo root, used by the admin server and the seed script) and fill in.
# Values: Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_… or legacy service_role): bypasses RLS. Admin only — NEVER in the app.
SUPABASE_SERVICE_ROLE_KEY=
